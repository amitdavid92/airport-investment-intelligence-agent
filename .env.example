# Copy to `.env` and fill in. `.env` is gitignored.

# Required for the chat agent. The scoring engine works without it.
# Free, no credit card: sign in with a Google account at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional override if the pinned model in agent/session.py is retired.
# Default: gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.7-flash

# Optional. Enables the real long-haul share computation from live OpenSky
# departure records. Without these, get_long_haul_share reports the figure as
# unavailable rather than estimating it.
# Create an API client at https://opensky-network.org/my-opensky
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
